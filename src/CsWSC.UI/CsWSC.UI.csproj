<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CsWSC\CsWSC.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CsWSC</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DebugType>embedded</DebugType>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Resources\CsWSC.ico</ApplicationIcon>
    <!-- Roslyn の各国語リソースは日本語だけ残す -->
    <SatelliteResourceLanguages>ja</SatelliteResourceLanguages>
    <!-- 動的 PGO の計測コードを省き、スクリプト再生までの待ちを短くする (計測で約 1 割短縮) -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <!-- Release では Scintilla のネイティブ DLL を x64 のみ配布する (パッケージが全アーキテクチャを Content として強制コピーするため) -->
  <Target Name="RemoveNonX64ScintillaRuntimes" AfterTargets="Build;Publish">
    <RemoveDir Directories="$(OutDir)runtimes\win-arm64;$(OutDir)runtimes\win-x86" />
    <RemoveDir Directories="$(PublishDir)runtimes\win-arm64;$(PublishDir)runtimes\win-x86" Condition="'$(PublishDir)' != ''" />
  </Target>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scintilla5.NET" Version="7.0.0" />
  </ItemGroup>

</Project>
